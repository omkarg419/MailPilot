# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (NextAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Drizzle / PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/MailPilot"

# Corsair integration layer
CORSAIR_KEK=""
APP_URL="http://localhost:3000"
# Calendar realtime push requires HTTPS — use ngrok locally, e.g. APP_URL="https://abc123.ngrok-free.app"
# Gmail Pub/Sub topic for push notifications (Phase 5 webhooks)
GMAIL_PUBSUB_TOPIC=""

# Anthropic (MailPilot Agent)
ANTHROPIC_API_KEY=""

